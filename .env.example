# ===================================================================
# PETRUZ MONTAGEM DE CARGA - VARIÁVEIS DE AMBIENTE (.env)
# Copie este arquivo para 'backend/.env' e preencha com suas credenciais reais.
# ===================================================================

# Configuração do Servidor Backend
PORT=5000
NODE_ENV=development

# Segurança de Autenticação JWT
JWT_SECRET=super-secure-jwt-secret-key-montagem-de-carga-2026!#$@
JWT_EXPIRES_IN=8h

# Banco de Dados Supabase (PostgreSQL Cloud)
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_KEY=sua-chave-anon-ou-service-role-do-supabase

# Integração SAP Business One Service Layer
SAP_SERVICE_LAYER_URL=https://sap-server.local:50000/b1s/v1
SAP_COMPANY_DB=SBO_PETRUZ
SAP_USERNAME=manager
SAP_PASSWORD=sua-senha-sap
SAP_MOCK_MODE=true

# Segurança de Rede e Políticas CORS
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Servidor de E-mail SMTP (Recuperação de Senha)
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=seu-email@petruz.com
SMTP_PASS=sua-senha-ou-app-password
SMTP_FROM=Petruz Cargas <no-reply@petruz.com>
SMTP_SECURE=false
